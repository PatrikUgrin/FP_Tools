<!DOCTYPE html>
<html lang="en-GB">
<head>
	<title>Static Spine Baker</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<style>
		html, body {
			margin: 0;
			padding: 0;
			height: 100%;
			overflow: hidden;
			background: #12141a;
			color: #e8e8e8;
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, sans-serif;
		}

		#app {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 400px;
			height: 100%;
		}

		#stage-wrap {
			position: relative;
			min-width: 0;
			background-image:
				linear-gradient(45deg, #1c1f28 25%, transparent 25%),
				linear-gradient(-45deg, #1c1f28 25%, transparent 25%),
				linear-gradient(45deg, transparent 75%, #1c1f28 75%),
				linear-gradient(-45deg, transparent 75%, #1c1f28 75%);
			background-size: 32px 32px;
			background-position: 0 0, 0 16px, 16px -16px, -16px 0;
			background-color: #151821;
		}

		#pixi-canvas {
			display: block;
			width: 100%;
			height: 100%;
		}

		#hud {
			position: absolute;
			left: 16px;
			top: 16px;
			padding: 10px 12px;
			background: rgba(12, 14, 20, 0.82);
			border: 1px solid #2a3140;
			border-radius: 6px;
			pointer-events: none;
		}

		#hud-title {
			font-size: 13px;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: #9aa4b5;
		}

		#hud-current {
			margin-top: 6px;
			font-size: 18px;
			font-weight: 600;
		}

		#sidebar {
			display: flex;
			flex-direction: column;
			gap: 12px;
			padding: 16px;
			background: #0e1116;
			border-left: 1px solid #2a3140;
			min-height: 0;
		}

		h1 {
			margin: 0;
			font-size: 18px;
			font-weight: 600;
		}

		.meta {
			font-size: 12px;
			color: #9aa4b5;
		}

		#status-pill,
		#renderer-pill {
			display: inline-block;
			margin-top: 6px;
			margin-right: 6px;
			padding: 4px 10px;
			border-radius: 999px;
			font-size: 11px;
			letter-spacing: 0.04em;
			font-weight: 600;
		}

		#renderer-pill {
			background: #1d3b28;
			color: #8ee0a8;
		}

		#renderer-pill.error {
			background: #3b1d1d;
			color: #f0a0a0;
		}

		#status-pill.idle {
			background: #1c222d;
			color: #c5cdd8;
		}

		#status-pill.baking {
			background: #1d3358;
			color: #9ec1ff;
			animation: status-pulse 1s ease-in-out infinite;
		}

		#status-pill.packing {
			background: #58401d;
			color: #e0c08e;
			animation: status-pulse 1s ease-in-out infinite;
		}

		#status-pill.done {
			background: #1d3b28;
			color: #8ee0a8;
		}

		#status-pill.error {
			background: #3b1d1d;
			color: #f0a0a0;
		}

		@keyframes status-pulse {
			0%, 100% { opacity: 1; }
			50% { opacity: 0.55; }
		}

		.progress-track {
			height: 10px;
			background: #1c222d;
			border-radius: 999px;
			overflow: hidden;
		}

		#progress-fill {
			height: 100%;
			width: 0%;
			background: #4c8dff;
		}

		#progress-label {
			font-size: 12px;
			color: #c5cdd8;
		}

		button {
			appearance: none;
			border: 0;
			border-radius: 6px;
			padding: 8px 12px;
			background: #4c8dff;
			color: #fff;
			font-size: 13px;
			cursor: pointer;
		}

		button:disabled {
			opacity: 0.45;
			cursor: default;
		}

		#save-paths-button {
			background: #2a3648;
		}

		#pack-button {
			background: #b07a3a;
		}

		.action-row {
			display: flex;
			gap: 8px;
		}

		.action-row button {
			flex: 1;
		}

		.path-block {
			display: flex;
			flex-direction: column;
			gap: 14px;
		}

		.path-group {
			display: flex;
			flex-direction: column;
			gap: 8px;
			padding: 10px 10px 10px 12px;
			border-radius: 6px;
			border: 1px solid transparent;
		}

		.path-group-title {
			font-size: 10px;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			font-weight: 700;
		}

		.path-group.input {
			background: #152033;
			border-color: #2a4a73;
		}

		.path-group.input .path-group-title {
			color: #9ec1ff;
		}

		.path-group.output {
			background: #15261c;
			border-color: #2d5a3c;
			margin-top: 4px;
		}

		.path-group.output .path-group-title {
			color: #8ee0a8;
		}

		.path-block label {
			display: flex;
			flex-direction: column;
			gap: 4px;
			font-size: 11px;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: #9aa4b5;
		}

		.path-block input {
			appearance: none;
			width: 100%;
			box-sizing: border-box;
			border: 1px solid #2a3140;
			border-radius: 6px;
			background: #0e1116;
			color: #e8e8e8;
			padding: 7px 8px;
			font-size: 12px;
			font-family: inherit;
		}

		.path-group.input input {
			border-color: #3a5f8f;
		}

		.path-group.pack {
			background: #261c15;
			border-color: #5a3d2d;
			margin-top: 4px;
		}

		.path-group.pack .path-group-title {
			color: #e0c08e;
		}

		.path-group.pack input {
			border-color: #8a6a45;
		}

		.path-block input.invalid {
			border-color: #c45b5b;
		}

		#path-error {
			font-size: 12px;
			color: #f0a0a0;
			white-space: pre-wrap;
			word-break: break-word;
			min-height: 1.2em;
		}

		#lan-urls {
			white-space: pre-wrap;
			word-break: break-all;
			font-family: Consolas, "Courier New", monospace;
			font-size: 11px;
			color: #c5cdd8;
		}

		#preview-wrap {
			background: #151821;
			border: 1px solid #2a3140;
			border-radius: 6px;
			min-height: 110px;
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}

		#preview-img {
			max-width: 100%;
			max-height: 140px;
			image-rendering: auto;
		}

		#log {
			flex: 1;
			min-height: 0;
			overflow: auto;
			font-size: 12px;
			line-height: 1.45;
			background: #10141b;
			border: 1px solid #2a3140;
			border-radius: 6px;
			padding: 8px;
			white-space: pre-wrap;
		}

		.log-error { color: #f0a0a0; }
		.log-skip { color: #c9b06a; }
		.log-ok { color: #8ee0a8; }
	</style>
</head>
<body>
	<div id="app">
		<div id="stage-wrap">
			<canvas id="pixi-canvas"></canvas>
			<div id="hud">
				<div id="hud-title">Live pose</div>
				<div id="hud-current">Waiting…</div>
			</div>
		</div>
		<aside id="sidebar">
			<div>
				<h1>Static Spine baker</h1>
				<div class="meta">Load-path poses only. Folders are animation names (or blur). Filenames are texture-cache names.</div>
				<div class="meta">On this PC double-click <code>Bake.bat</code>. Other machines open a LAN address below (slot game keeps 1234).</div>
				<div class="meta" id="lan-urls">Loading addresses…</div>
				<div>
					<div id="status-pill" class="idle">Status: Idle</div>
					<div id="renderer-pill">Renderer: checking</div>
				</div>
			</div>
			<div>
				<div id="progress-label">0 / 0</div>
				<div class="progress-track"><div id="progress-fill"></div></div>
			</div>
			<div class="path-block">
				<div class="path-group input">
					<div class="path-group-title">Input — read from</div>
					<label>Spine folder
						<input id="spine-folder" type="text" spellcheck="false" autocomplete="off">
					</label>
					<label>Spritesheet folder
						<input id="spritesheet-folder" type="text" spellcheck="false" autocomplete="off" placeholder="Folder that contains symbols_img.json">
					</label>
				</div>
				<div class="path-group output">
					<div class="path-group-title">Output — write to</div>
					<label>Export folder
						<input id="export-folder" type="text" spellcheck="false" autocomplete="off">
					</label>
				</div>
				<div class="path-group pack">
					<div class="path-group-title">Pack — TexturePacker</div>
					<label>TPS folder
						<input id="tps-folder" type="text" spellcheck="false" autocomplete="off" placeholder="Folder of .tps project files">
					</label>
				</div>
				<button id="save-paths-button" type="button">Save paths</button>
				<div class="meta" id="path-file-label">Saved in baker-paths.txt</div>
				<div id="path-error"></div>
			</div>
			<div class="action-row">
				<button id="bake-button" type="button">Bake PNGs</button>
				<button id="pack-button" type="button">Pack spritesheets</button>
			</div>
			<div class="meta" id="export-path">Writing to export/png/&lt;animation or blur&gt;/</div>
			<div id="preview-wrap">
				<img id="preview-img" alt="Last exported PNG">
			</div>
			<div id="log"></div>
		</aside>
	</div>
</body>
</html>
