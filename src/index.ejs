<!DOCTYPE html>
<html lang="en-GB">
<head>
	<title>Static Spine Baker</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<style>
		html, body {
			margin: 0;
			padding: 0;
			height: 100%;
			overflow: hidden;
			background: #12141a;
			color: #e8e8e8;
			font-family: "Segoe UI", Tahoma, sans-serif;
		}

		#app {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 360px;
			height: 100%;
		}

		#stage-wrap {
			position: relative;
			min-width: 0;
			background-image:
				linear-gradient(45deg, #1c1f28 25%, transparent 25%),
				linear-gradient(-45deg, #1c1f28 25%, transparent 25%),
				linear-gradient(45deg, transparent 75%, #1c1f28 75%),
				linear-gradient(-45deg, transparent 75%, #1c1f28 75%);
			background-size: 32px 32px;
			background-position: 0 0, 0 16px, 16px -16px, -16px 0;
			background-color: #151821;
		}

		#pixi-canvas {
			display: block;
			width: 100%;
			height: 100%;
		}

		#hud {
			position: absolute;
			left: 16px;
			top: 16px;
			padding: 10px 12px;
			background: rgba(12, 14, 20, 0.82);
			border: 1px solid #2a3140;
			border-radius: 6px;
			pointer-events: none;
		}

		#hud-title {
			font-size: 13px;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: #9aa4b5;
		}

		#hud-current {
			margin-top: 6px;
			font-size: 18px;
			font-weight: 600;
		}

		#sidebar {
			display: flex;
			flex-direction: column;
			gap: 12px;
			padding: 16px;
			background: #0e1116;
			border-left: 1px solid #2a3140;
			min-height: 0;
		}

		h1 {
			margin: 0;
			font-size: 18px;
			font-weight: 600;
		}

		.meta {
			font-size: 12px;
			color: #9aa4b5;
		}

		#renderer-pill {
			display: inline-block;
			margin-top: 6px;
			padding: 2px 8px;
			border-radius: 999px;
			font-size: 11px;
			letter-spacing: 0.04em;
			background: #1d3b28;
			color: #8ee0a8;
		}

		#renderer-pill.error {
			background: #3b1d1d;
			color: #f0a0a0;
		}

		.progress-track {
			height: 10px;
			background: #1c222d;
			border-radius: 999px;
			overflow: hidden;
		}

		#progress-fill {
			height: 100%;
			width: 0%;
			background: #4c8dff;
		}

		#progress-label {
			font-size: 12px;
			color: #c5cdd8;
		}

		button {
			appearance: none;
			border: 0;
			border-radius: 6px;
			padding: 8px 12px;
			background: #4c8dff;
			color: #fff;
			font-size: 13px;
			cursor: pointer;
		}

		button:disabled {
			opacity: 0.45;
			cursor: default;
		}

		#preview-wrap {
			background: #151821;
			border: 1px solid #2a3140;
			border-radius: 6px;
			min-height: 160px;
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}

		#preview-img {
			max-width: 100%;
			max-height: 220px;
			image-rendering: auto;
		}

		#log {
			flex: 1;
			min-height: 0;
			overflow: auto;
			font-size: 12px;
			line-height: 1.45;
			background: #10141b;
			border: 1px solid #2a3140;
			border-radius: 6px;
			padding: 8px;
			white-space: pre-wrap;
		}

		.log-error { color: #f0a0a0; }
		.log-skip { color: #c9b06a; }
		.log-ok { color: #8ee0a8; }
	</style>
</head>
<body>
	<div id="app">
		<div id="stage-wrap">
			<canvas id="pixi-canvas"></canvas>
			<div id="hud">
				<div id="hud-title">Live pose</div>
				<div id="hud-current">Waiting…</div>
			</div>
		</div>
		<aside id="sidebar">
			<div>
				<h1>Static Spine baker</h1>
				<div class="meta">Load-path poses only. Folders are animation names (or blur). Filenames are texture-cache names.</div>
				<div id="renderer-pill">Renderer: checking</div>
			</div>
			<div>
				<div id="progress-label">0 / 0</div>
				<div class="progress-track"><div id="progress-fill"></div></div>
			</div>
			<button id="bake-button" type="button">Bake PNGs</button>
			<div class="meta" id="export-path">Writing to export/png/&lt;animation or blur&gt;/</div>
			<div id="preview-wrap">
				<img id="preview-img" alt="Last exported PNG">
			</div>
			<div id="log"></div>
		</aside>
	</div>
</body>
</html>
